POSTGRES_DB=corteya
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/corteya
DB_USERNAME=corteya_app
CORTEYA_OWNER_PASSWORD=
CORTEYA_APP_PASSWORD=
DB_PASSWORD=${CORTEYA_APP_PASSWORD}
FLYWAY_USERNAME=corteya_owner
FLYWAY_PASSWORD=${CORTEYA_OWNER_PASSWORD}

# Local development only; replace with a random secret in production (>=32 bytes).
AUTH_OTP_PEPPER=local-development-only-pepper-change-before-production
# dev defaults to log, production defaults to whatsapp. The property selects the sender.
# AUTH_OTP_SENDER=whatsapp
# AUTH_JWT_KID=production-key-id
# AUTH_JWT_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----'
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=
# WHATSAPP_GRAPH_VERSION= (choose a supported Meta Graph API version)
# WHATSAPP_TEMPLATE_LANGUAGE=es_CO

# AES-256-GCM master key (all profiles): generate with openssl rand -base64 32.
# Keep outside Git; losing this key loses access to the encrypted Wompi credentials.
PAYMENT_SECRETS_KEY=
PAYMENT_SECRETS_KEY_VERSION=1
# Rotation only: retain old decryption keys as version:base64,version:base64 (secret).
PAYMENT_SECRETS_PREVIOUS_KEYS=
PAYMENTS_PUBLIC_BASE_URL=http://localhost:8080
PAYMENTS_REDIRECT_URL=corteya://appointments/
# ONLY dev: all four nonempty values enable Wompi SANDBOX on the demo shop.
# Missing/partial values leave the demo in BREB_MANUAL. Never put real values here.
WOMPI_SANDBOX_PUBLIC_KEY=
WOMPI_SANDBOX_PRIVATE_KEY=
WOMPI_SANDBOX_INTEGRITY_SECRET=
WOMPI_SANDBOX_EVENTS_SECRET=
