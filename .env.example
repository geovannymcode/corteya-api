POSTGRES_DB=corteya
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/corteya
DB_USERNAME=corteya_app
CORTEYA_OWNER_PASSWORD=
CORTEYA_APP_PASSWORD=
DB_PASSWORD=${CORTEYA_APP_PASSWORD}
FLYWAY_USERNAME=corteya_owner
FLYWAY_PASSWORD=${CORTEYA_OWNER_PASSWORD}

# Local development only; replace with a random secret in production (>=32 bytes).
AUTH_OTP_PEPPER=local-development-only-pepper-change-before-production
# dev defaults to log, production defaults to whatsapp. The property selects the sender.
# AUTH_OTP_SENDER=whatsapp
# AUTH_JWT_KID=production-key-id
# AUTH_JWT_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----'
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=
# WHATSAPP_GRAPH_VERSION= (choose a supported Meta Graph API version)
# WHATSAPP_TEMPLATE_LANGUAGE=es_CO
