{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Bogota",
  "schedule": ["* * * * 1"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Versiones mayores: requieren aprobación en el Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Spring Boot y su plugin en un solo PR",
      "matchPackageNames": ["/^org\\.springframework\\.boot/"],
      "groupName": "spring boot"
    },
    {
      "description": "Kotlin y sus plugins (jvm, spring, jpa) juntos",
      "matchPackageNames": ["/^org\\.jetbrains\\.kotlin/"],
      "groupName": "kotlin"
    },
    {
      "description": "Testcontainers junto",
      "matchPackageNames": ["/^org\\.testcontainers/"],
      "groupName": "testcontainers"
    },
    {
      "description": "Postgres: nunca saltar de versión mayor automáticamente",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}